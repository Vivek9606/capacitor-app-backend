# Postgres connection. On Supabase use the *session pooler* URL (IPv4), not db.<ref>.supabase.co (IPv6-only):
# postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Long random string (e.g. `openssl rand -base64 48`). Rotating it logs everyone out.
JWT_SECRET=

PORT=8080

# Comma-separated web origins allowed to call the API. Capacitor app origins are always allowed.
CORS_ORIGINS=https://betterhood.in,https://www.betterhood.in

# Public web app URL — used in links sent on WhatsApp.
PUBLIC_WEB_URL=https://betterhood.in

# WhatsApp delivery: "log" (prints messages to the server log) or "meta" (WhatsApp Cloud API).
WHATSAPP_PROVIDER=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Development/staging only: accept this fixed OTP for every number. NEVER set in production.
OTP_DEV_CODE=
