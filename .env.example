# Postgres connection. On Supabase use the *session pooler* URL (IPv4), not db.<ref>.supabase.co (IPv6-only):
# postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Long random string (e.g. `openssl rand -base64 48`). Rotating it logs everyone out.
JWT_SECRET=

PORT=8080

# Comma-separated web origins allowed to call the API. Capacitor app origins are always allowed.
CORS_ORIGINS=https://betterhood.in,https://www.betterhood.in

# Public web app URL — used in links sent on WhatsApp.
PUBLIC_WEB_URL=https://betterhood.in

# WhatsApp delivery: "log" (prints messages to the server log), "kwikengage" (KwikEngage / GoKwik API)
# or "meta" (WhatsApp Cloud API directly).
WHATSAPP_PROVIDER=log
KWIKENGAGE_API_KEY=
# Only send to these numbers (comma-separated). Leave empty to send to everyone. Use this while testing.
WHATSAPP_ALLOWLIST=
# Only send these templates (comma-separated, must be approved). Others are just logged. Empty = all.
WHATSAPP_TEMPLATES=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Development/staging only: accept this fixed OTP for every number. NEVER set in production.
OTP_DEV_CODE=

# Video consults (LiveKit Cloud: Project settings → Keys). Leave empty to turn video off.
# Local testing: run `livekit-server --dev` and use ws://localhost:7880, devkey, secret.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# betterhood.in physio directory. Listings are made on the website (/physio-directory/join/), or in the app,
# which opens that same page. Add the website's origin to CORS_ORIGINS so its form can call this API.
PUBLIC_SITE_URL=https://betterhood.in
# Where the app's web build runs (e.g. https://capacitor-app-three.vercel.app). Website profiles link to
# {PUBLIC_APP_URL}/dr/{slug}/book for booking. Defaults to PUBLIC_WEB_URL.
PUBLIC_APP_URL=
# Rebuild the website when a listing is saved, so it goes live in minutes. A fine-grained GitHub token with
# "Contents: read & write" on the website repo (needed for repository_dispatch). Leave empty to skip.
SITE_REBUILD_REPO=Vivek9606/betterhood-revamp
SITE_REBUILD_TOKEN=
